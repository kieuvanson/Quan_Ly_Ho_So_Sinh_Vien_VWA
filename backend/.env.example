# =====================================================================
# Biến môi trường cho backend VWA EduRecords
# Sao chép thành .env rồi điền giá trị thật. KHÔNG commit file .env.
# =====================================================================

# ===== Database (bắt buộc) =====
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/vwa_edurecords?sslmode=disable
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=

# ===== Redis (bắt buộc) =====
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=
SPRING_DATA_REDIS_TIMEOUT=2000ms

# ===== JWT (bắt buộc) =====
# Chuỗi ngẫu nhiên >= 32 ký tự cho HS256. KHÔNG để trống, KHÔNG dùng lại
# giá trị mẫu, KHÔNG dùng mật khẩu thật.
APP_SECURITY_JWT_SECRET=
APP_SECURITY_JWT_ACCESS_TOKEN_TTL=PT1H
APP_SECURITY_JWT_REFRESH_TOKEN_TTL=P7D
APP_SECURITY_JWT_ISSUER=vwa-edurecords

# ===== CORS (bắt buộc) =====
# Danh sách origin cách nhau bởi dấu phẩy. KHÔNG dùng "*".
APP_SECURITY_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ===== Cookie =====
# true khi chạy HTTPS (bắt buộc ở production), false chỉ cho local.
APP_SECURITY_COOKIE_SECURE=false
APP_SECURITY_COOKIE_SAMESITE=Lax

# ===== Rate limit đăng nhập =====
APP_SECURITY_RATELIMIT_LOGIN_MAX_ATTEMPTS=5
APP_SECURITY_RATELIMIT_LOGIN_WINDOW_SECONDS=60

# ===== Server =====
SERVER_PORT=8081

# ===== Admin khởi tạo (tuỳ chọn) =====
# Chỉ dùng khi bảng users còn trống. Mật khẩu tối thiểu 12 ký tự.
# Xem vn.vwa.edurecords.config.AdminBootstrap.
APP_ADMIN_USERNAME=
APP_ADMIN_PASSWORD=
APP_ADMIN_HO_TEN=
APP_ADMIN_EMAIL=
