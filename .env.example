# =====================================================================
# Biến môi trường cho VWA EduRecords
# Sao chép file này thành .env rồi điền giá trị thật. KHÔNG commit file .env.
# =====================================================================

# ===================
# Database (bắt buộc)
# ===================
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/vwa_edurecords?sslmode=disable
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=

# Biến dưới đây CHỈ dùng khi deploy Docker Compose (docker-compose.yml và
# docker-compose.prod.yml). Chúng cấu hình cho container postgres khởi tạo
# database và user lần đầu. Xoá 3 biến này nếu chỉ chạy local với
# PostgreSQL đã cài sẵn trên máy.
#
# LƯU Ý QUAN TRỌNG: password postgres chỉ có tác dụng lúc container khởi
# tạo lần đầu. Đổi biến này sau khi database đã có dữ liệu sẽ KHÔNG đổi
# được mật khẩu thật trong database.
#
# LƯU Ý QUAN TRỌNG 2: trong Docker, backend phải trỏ tới hostname "postgres"
# (tên service), KHÔNG phải localhost. Khi đó SPRING_DATASOURCE_URL nên là:
#   SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/vwa_edurecords?sslmode=disable
POSTGRES_DB=vwa_edurecords
POSTGRES_USER=vwa
POSTGRES_PASSWORD=

# ===================
# Redis (bắt buộc)
# ===================
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=

# ===================
# JWT (bắt buộc)
# ===================
# Sinh chuỗi ngẫu nhiên >= 32 ký tự, KHÔNG dùng lại giá trị mẫu.
# PowerShell:
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
APP_SECURITY_JWT_SECRET=
APP_SECURITY_JWT_ACCESS_TOKEN_TTL=PT1H
APP_SECURITY_JWT_REFRESH_TOKEN_TTL=P7D
APP_SECURITY_JWT_ISSUER=vwa-edurecords

# ===================
# CORS (bắt buộc) — danh sách origin cách nhau bởi dấu phẩy, KHÔNG dùng "*"
# ===================
APP_SECURITY_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ===================
# Cookie
# ===================
# APP_SECURITY_COOKIE_SECURE: true khi chạy HTTPS (BẮT BUỘC ở production),
# false chỉ dùng cho local.
APP_SECURITY_COOKIE_SECURE=false

# APP_SECURITY_COOKIE_SAMESITE: chọn theo quan hệ domain giữa frontend và backend.
#
#   Lax  -> dùng khi frontend và backend CÙNG một site (cùng domain gốc).
#            Ví dụ: vwa.edu.vn (Vercel) + api.vwa.edu.vn (VPS).
#            Đây là lựa chọn an toàn nhất, KHÔNG cần đổi gì thêm.
#
#   None -> BẮT BUỘC khi frontend và backend KHÁC site (cross-site), ví dụ
#            frontend ở *.vercel.app. Cookie SameSite=None bắt buộc phải đi kèm
#            APP_SECURITY_COOKIE_SECURE=true, và trình duyệt chỉ chấp nhận cookie
#            khi request đi qua HTTPS.
#
# Triệu chứng khi đặt sai: đăng nhập được, nhưng sau khoảng 1 giờ (hết hạn
# access token) thì bị đá ra khỏi phiên và không tự đăng nhập lại được.
APP_SECURITY_COOKIE_SAMESITE=Lax

# ===================
# Tài khoản quản trị đầu tiên
# ===================
# Chỉ dùng khi bảng users còn trống. Mật khẩu tối thiểu 12 ký tự.
# Sau lần đăng nhập đầu tiên nên xoá APP_ADMIN_PASSWORD khỏi môi trường.
APP_ADMIN_USERNAME=
APP_ADMIN_PASSWORD=
APP_ADMIN_HO_TEN=
APP_ADMIN_EMAIL=

# ===================
# Port
# ===================
SERVER_PORT=8081

# ===================
# Heap cho JVM (chỉ dùng khi deploy Docker)
# ===================
# Import Excel (tối đa 10MB, batch 500 bản ghi) dễ OOM nếu heap quá nhỏ.
# Đặt JVM_XMX bằng khoảng 1/3 tổng RAM VPS.
#   VPS 2GB  -> JVM_XMX=1g
#   VPS 4GB  -> JVM_XMX=2g
# Tổng heap + Postgres + Redis + nginx KHÔNG nên vượt quá RAM thật,
# nếu không container sẽ bị OOM-killed.
JVM_XMS=256m
JVM_XMX=1g

# ===================
# Forward headers (chỉ dùng khi deploy sau reverse proxy)
# ===================
# Đặt "framework" khi backend đứng sau nginx/Caddy để nhận đúng
# scheme/host/IP gốc. Giữ "none" khi chạy local không qua proxy.
SERVER_FORWARD_HEADERS_STRATEGY=none
